generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  firstName String
  lastName  String
  password  String
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaries        Salary[]
  groupClasses    GroupClass[]
  inventoryLoans  InventoryLoan[]
  maintenanceLogs MaintenanceLog[]
}

model Salary {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  amount      Decimal
  paymentDate DateTime
  receipt     String?
}

model Member {
  id              Int      @id @default(autoincrement())
  firstName       String
  lastName        String
  dni             String   @unique
  birthDate       DateTime
  contact         String?
  socialFeePaid   Boolean  @default(false)
  accumulatedDebt Decimal  @default(0)

  memberGroups MemberGroup[]
  attendances  Attendance[]
}

model Discipline {
  id   Int    @id @default(autoincrement())
  name String @unique

  groupClasses GroupClass[]
}

model GroupClass {
  id           Int        @id @default(autoincrement())
  disciplineId Int
  discipline   Discipline @relation(fields: [disciplineId], references: [id])
  userId       Int
  user         User       @relation(fields: [userId], references: [id])
  schedule     String
  days         String

  memberGroups MemberGroup[]
  attendances  Attendance[]
}

model MemberGroup {
  id               Int        @id @default(autoincrement())
  memberId         Int
  member           Member     @relation(fields: [memberId], references: [id])
  groupClassId     Int
  groupClass       GroupClass @relation(fields: [groupClassId], references: [id])
  sportsFeePaid    Boolean    @default(false)

  @@unique([memberId, groupClassId])
}

model Attendance {
  id           Int        @id @default(autoincrement())
  groupClassId Int
  groupClass   GroupClass @relation(fields: [groupClassId], references: [id])
  memberId     Int
  member       Member     @relation(fields: [memberId], references: [id])
  date         DateTime
  present      Boolean
}

model Inventory {
  id                Int    @id @default(autoincrement())
  name              String
  totalQuantity     Int
  availableQuantity Int

  loans InventoryLoan[]
}

model InventoryLoan {
  id           Int       @id @default(autoincrement())
  itemId       Int
  item         Inventory @relation(fields: [itemId], references: [id])
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  checkoutDate DateTime
  returnDate   DateTime?
  returned     Boolean   @default(false)
}

model Facility {
  id   Int    @id @default(autoincrement())
  name String

  maintenanceLogs MaintenanceLog[]
}

model MaintenanceLog {
  id             Int       @id @default(autoincrement())
  facilityId     Int
  facility       Facility  @relation(fields: [facilityId], references: [id])
  userId         Int
  user           User      @relation(fields: [userId], references: [id])
  date           DateTime
  taskDescription String
  suppliesNeeded String?
  status         String
}
